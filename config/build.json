{
    "version": "2.0.0",
    "github": {
        "repo": "Astraxical/displau",
        "branch": "master"
    },
    "paths": {
        "timers": "timers",
        "output": "output",
        "components": "components"
    },
    "build": {
        "default_target_time": "2026-03-31T05:00:00",
        "output_pattern": "{config_id}.html",
        "include_unused_scripts": false
    },
    "cache": {
        "duration_minutes": 5,
        "localStorage_key": "seven_segment_config"
    },
    "lock": {
        "enabled": true,
        "pin_sha256": "a1fb4e703a9ef1fa4936801721ff285a97ac85330856674412e054892afe6972",
        "hint": "demo PIN is 2468 — change me with: python3 src/vMain.py --hash-pin YOURPIN"
    }
}
